# Frontend — shared reference (see also .env.local.example / .env.production.example)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=/api/wilms
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_WILMS_ENV=development
NEXT_PUBLIC_APP_LOCK_IDLE_MS=300000

# v1.5+: API runs in-process via Route Handlers. Set WILMS_API_MODE=proxy only for dual-run.
# WILMS_API_MODE=proxy
# WILMS_API_UPSTREAM=http://127.0.0.1:4000

# Domain / database (same Neon credentials as former Railway API)
DATABASE_URL=
WILMS_SESSION_SECRET=
WILMS_SCHEDULER_TOKEN=
CRON_SECRET=
REDIS_URL=
WILMS_REDIS_URL=

# Demo / mock toggles (unset = default mock in development when API URL empty)
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_FORCE_DEMO_MODE=
NEXT_PUBLIC_API_DISABLED=

# E2E (used by playwright.config.ts)
FRONTEND_PORT=3000
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=3000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
E2E_HOST=127.0.0.1
E2E_PORT=3000

# Mail / SMS / uploads — configure on Vercel Preview + Production
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
WILMS_INTERNAL_MAIL_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
