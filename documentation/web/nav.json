  "faq": [
    {
      "question": "Where did Export Center go?",
      "answer": "The standalone Export Center route was removed in v1.7.3. Use contextual export buttons on report pages, borrower profiles, and executive intelligence."
    },
    {
      "question": "How do I generate PDF manuals?",
      "answer": "Run npm run docs:generate from the repository root. Outputs appear in documentation/pdf/ and documentation/docx/."
    },
    {
      "question": "What authentication does WILMS use?",
      "answer": "Custom HMAC-signed session cookies (wilms_session), not Auth.js or JWT bearer tokens."
    },
    {
      "question": "How is money stored?",
      "answer": "Integer pesewas in the database. 100 pesewas = 1 GHS. No floating-point arithmetic."
    }
  ],
  "glossary": [
    { "term": "Pesewas", "definition": "Integer money unit; 100 pesewas = 1 GHS" },
    { "term": "Pool", "definition": "Capital fund from which loans are disbursed" },
    { "term": "Maker-checker", "definition": "Dual-control requiring different users for submit and approve" },
    { "term": "SoD", "definition": "Separation of duties" },
    { "term": "RBAC", "definition": "Role-based access control" },
    { "term": "Contextual export", "definition": "Export action embedded in the page displaying source data" }
  ]
