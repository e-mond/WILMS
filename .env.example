# =============================================================================
# WILMS Monorepo — Environment Reference (root)
# Copy values into apps/frontend/.env.local and/or packages/domain/.env.local.
# Never commit real secrets. Full reference: docs/environment.md
# =============================================================================

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=/api/wilms
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_FORCE_DEMO_MODE=false
NEXT_PUBLIC_API_DISABLED=false
NEXT_PUBLIC_WILMS_ENV=development
NEXT_PUBLIC_APP_LOCK_IDLE_MS=300000

# Dual-run only (omit for in-process Route Handlers):
# WILMS_API_MODE=proxy
# WILMS_API_UPSTREAM=http://127.0.0.1:4000

# --- Domain (also loaded by Route Handlers on the Next server) ---
WILMS_API_PORT=4000
WILMS_API_HOST=127.0.0.1
WILMS_CORS_ORIGIN=http://127.0.0.1:3000
WILMS_SESSION_SECRET=
WILMS_MIN_GROUP_SIZE=5
WILMS_MAX_GROUP_SIZE=15
WILMS_SCHEDULER_TOKEN=
CRON_SECRET=
WILMS_METRICS_TOKEN=
REDIS_URL=
WILMS_REDIS_URL=

# --- Database (Neon PostgreSQL) ---
# When unset, domain uses in-memory persistence (local demo only).
DATABASE_URL=

# --- Uploads ---
UPLOAD_PROVIDER=local
WILMS_UPLOAD_DIR=.wilms-uploads
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wilms

# --- Mail ---
MAIL_PROVIDER=none
MAIL_FROM=noreply@wilms.local
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=
WILMS_INTERNAL_MAIL_SECRET=

# --- SMS ---
SMS_PROVIDER=none
SMSNOTIFYGH_API_KEY=
SMSNOTIFYGH_SENDER_ID=
SMSNOTIFYGH_API_URL=https://sms.smsnotifygh.com/smsapi
SMSNOTIFYGH_BALANCE_URL=https://sms.smsnotifygh.com/api/balance/sms

# --- E2E / Playwright ---
FRONTEND_PORT=3000
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=3000
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

NODE_ENV=development
