{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @wilms/frontend",
  "outputDirectory": "apps/frontend/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "apps/frontend/src/app/api/wilms/[...path]/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "apps/frontend/src/app/api/cron/notifications/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!_next/static).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
